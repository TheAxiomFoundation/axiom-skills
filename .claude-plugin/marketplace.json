{
  "$schema": "https://claude.ai/schemas/plugin-marketplace.json",
  "name": "axiom-skills",
  "version": "0.2.0",
  "description": "Shared agent/skill infrastructure for the Axiom Foundation \u2014 pipeline knowledge, craft conventions, and (later) operational agents, reusable across every Axiom repo and harness",
  "owner": {
    "name": "Axiom Foundation",
    "url": "https://github.com/TheAxiomFoundation"
  },
  "plugins": [
    {
      "name": "essential",
      "source": "./",
      "strict": false,
      "description": "Baseline for every Axiom repo: RuleSpec format, engine usage, Axiom writing voice, and the Axiom MCP server",
      "category": "core",
      "version": "0.2.0",
      "license": "Apache-2.0",
      "skills": [
        "./skills/axiom-ecosystem",
        "./skills/rulespec-format",
        "./skills/engine-api",
        "./skills/axiom-writing"
      ],
      "mcpServers": "./mcp/axiom.json"
    },
    {
      "name": "encoding",
      "source": "./",
      "strict": false,
      "description": "For pipeline contributors: encode CLI + gauntlet discipline, corpus ingestion/publication, oracle/parity validation",
      "category": "pipeline",
      "version": "0.2.0",
      "license": "Apache-2.0",
      "skills": [
        "./skills/encode-cli",
        "./skills/corpus-usage",
        "./skills/oracles-usage"
      ]
    },
    {
      "name": "craft",
      "source": "./",
      "strict": false,
      "description": "For demo and app builders: Axiom design/demo conventions and writing voice",
      "category": "craft",
      "version": "0.2.0",
      "license": "Apache-2.0",
      "skills": [
        "./skills/axiom-design",
        "./skills/axiom-writing"
      ]
    },
    {
      "name": "complete",
      "source": "./",
      "strict": false,
      "description": "Everything in the catalog",
      "category": "core",
      "version": "0.2.0",
      "license": "Apache-2.0",
      "skills": [
        "./skills/axiom-ecosystem",
        "./skills/rulespec-format",
        "./skills/engine-api",
        "./skills/encode-cli",
        "./skills/corpus-usage",
        "./skills/oracles-usage",
        "./skills/axiom-writing",
        "./skills/axiom-design"
      ],
      "mcpServers": "./mcp/axiom.json"
    }
  ]
}
